# Local development only — Vite reads this file (see vite.config.ts).

# Base URL for the widget's /api/* calls. Leave EMPTY so the calls stay
# relative, i.e. same-origin. See README.
VITE_WIDGET_API_URL=

# Dev-server proxy target for /api/* — the backend answering /api/chat,
# /api/visit and /api/history while `npm run dev` is running.
API_PROXY_TARGET=

# ---------------------------------------------------------------------------
# NOT read from this file. WIDGET_FRAME_ANCESTORS and WIDGET_CHANNEL_* are
# CONTAINER runtime variables, applied at start-up by
# docker-entrypoint.d/10-widget-config.envsh — set them on the deployment
# (Dokploy), not here. Locally the contact channels come from the checked-in
# public/config.js instead.
# ---------------------------------------------------------------------------
